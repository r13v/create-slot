{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true,

    /* Bundler mode */
    "moduleResolution": "bundler",

    /* The smoke tests import the package by its own name; resolve those
       self-reference specifiers to source so typecheck needs no built dist. */
    "paths": {
      "create-slot": ["./lib/index.ts"],
      "create-slot/core": ["./lib/core/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* tsup's dts build injects `baseUrl`, which TypeScript 6 deprecates. */
    "ignoreDeprecations": "6.0",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["lib", "test"]
}
