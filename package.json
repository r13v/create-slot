{
  "name": "create-slot",
  "version": "3.1.0",
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "examples/*"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "repository": "r13v/create-slot",
  "scripts": {
    "bundle": "tsup && node scripts/prepend-use-client.mjs",
    "dev:spa": "npm run bundle && npm run dev --workspace crm-spa",
    "dev:next-pages": "npm run bundle && npm run dev --workspace crm-nextjs-pages",
    "dev:next-app": "npm run bundle && npm run dev --workspace crm-nextjs-app",
    "build:examples": "npm run bundle && npm run build --workspace crm-spa && npm run build --workspace crm-nextjs-pages && npm run build --workspace crm-nextjs-app",
    "site:dev": "npm run bundle && npm run dev --prefix docs-site",
    "site:build": "npm run bundle && npm run build --prefix docs-site",
    "site:preview": "npm run preview --prefix docs-site",
    "site:typecheck": "npm run typecheck --prefix docs-site",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "knip": "knip",
    "format": "biome format --write",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "bench": "vitest bench --run",
    "test:rsc": "node --conditions react-server test/react-server-smoke.mjs",
    "test:chunks": "node test/chunk-sharing-smoke.cjs"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
