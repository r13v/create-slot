{
  "name": "crm-core",
  "version": "0.0.0",
  "private": true,
  "description": "The CRM the Next.js examples share: domain data, slots, plugins and pages. The shells around it live in ../nextjs-pages and ../nextjs-app; ../spa shares the data and the stylesheet.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
