    "./crm.css": "./src/crm.css"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "create-slot": "file:../..",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "react-redux": "^9.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "^6.0.3"
  }
}
